# TerraPulse - Backend Environment Configuration
# Copy this file to `.env` (same folder) and fill in YOUR values.
# NEVER commit `.env` to git. NEVER put real secrets in this example file.
#
#   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)

# NISAR Earthdata Authentication (REQUIRED for live data)
# -------------------------------------------------------
# 1. Register free at https://urs.earthdata.nasa.gov/
# 2. Put your login below in `.env` (NOT in this file)
#
# NASA_EARTHDATA_USERNAME=your_earthdata_username
# NASA_EARTHDATA_PASSWORD=your_earthdata_password

# Optional: Custom configuration
# ------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# CORS configuration
CORS_ORIGINS=http://localhost:5173

# Persistent SQLite database path
TERRAPULSE_DB_PATH=./data/terrapulse.db

# Data provider settings
DATA_PROVIDER=earthdata
CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO
